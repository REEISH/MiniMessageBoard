<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Message</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <h1>Mini Message Board</h1>
    </header>

    <main>
      <div
        class="message-form-container"
        style="
          background: #f4f4f4;
          padding: 1.5rem;
          border-radius: 8px;
          margin-bottom: 2rem;
        "
      >
        <h2>Post a New Message</h2>
        <form method="POST" action="/new" class="message-form">
          <div class="form-group" style="margin-bottom: 1rem">
            <label
              for="user"
              style="display: block; font-weight: bold; margin-bottom: 0.5rem"
              >Name:</label
            >
            <input
              type="text"
              id="user"
              name="user"
              required
              autofocus
              style="width: 100%; padding: 0.5rem; box-sizing: border-box"
            />
          </div>

          <div class="form-group" style="margin-bottom: 1rem">
            <label
              for="text"
              style="display: block; font-weight: bold; margin-bottom: 0.5rem"
              >Message:</label
            >
            <textarea
              id="text"
              name="text"
              rows="4"
              required
              style="width: 100%; padding: 0.5rem; box-sizing: border-box"
            ></textarea>
          </div>

          <button
            type="submit"
            class="btn-submit"
            style="
              padding: 10px 15px;
              background: #28a745;
              color: white;
              border: none;
              border-radius: 5px;
              cursor: pointer;
            "
          >
            Post Message
          </button>
        </form>
      </div>

      <a href="/" class="back-link">&larr; Back to Messages</a>
    </main>
  </body>
</html>
